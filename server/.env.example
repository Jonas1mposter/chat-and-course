# 复制为 .env 并修改
PORT=4000
DATABASE_URL=postgres://xueshe:CHANGE_ME@127.0.0.1:5432/xueshe
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# 允许跨域的前端域名（多个用逗号分隔），开发可填 *
CORS_ORIGIN=*

# 本地文件上传配置（未配置 COS 时默认使用）
# 上传文件会存到 server/uploads/ 并通过 /uploads 静态访问
UPLOADS_BASE_URL=https://api.superbrain-studio.cn
# 单文件最大限制（字节），默认 2 GB
MAX_UPLOAD_BYTES=2147483648

# 腾讯云 COS（可选）— 配置后将优先使用 COS 直传
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE=